<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="EpicTripProgressPrimaryTextLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_maneuver_icon_light</item>
    </style>

    <style name="EpicTripProgressPrimaryTextDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicTripProgressSubTextLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_maneuver_icon_light</item>
    </style>

    <style name="EpicTripProgressSubTextDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicTripProgressStyleLight" parent="MapboxStyleTripProgressView">
        <item name="tripProgressViewBackgroundColor">@color/epic_surface_light</item>
        <item name="tripProgressTextColor">@color/epic_maneuver_icon_light</item>
        <item name="timeRemainingTextAppearance">@style/EpicTripProgressPrimaryTextLight</item>
        <item name="distanceRemainingTextAppearance">@style/EpicTripProgressSubTextLight</item>
        <item name="estimatedArrivalTimeTextAppearance">@style/EpicTripProgressSubTextLight</item>
        <item name="distanceRemainingIconTint">@color/epic_maneuver_icon_light</item>
        <item name="estimatedArrivalTimeIconTint">@color/epic_maneuver_icon_light</item>
        <item name="android:textColor">@color/epic_maneuver_icon_light</item>
        <item name="android:tint">@color/epic_maneuver_icon_light</item>
    </style>

    <style name="EpicTripProgressStyleDark" parent="MapboxStyleTripProgressView">
        <item name="tripProgressViewBackgroundColor">@color/epic_surface_dark</item>
        <item name="tripProgressTextColor">@color/epic_text_primary_dark</item>
        <item name="timeRemainingTextAppearance">@style/EpicTripProgressPrimaryTextDark</item>
        <item name="distanceRemainingTextAppearance">@style/EpicTripProgressSubTextDark</item>
        <item name="estimatedArrivalTimeTextAppearance">@style/EpicTripProgressSubTextDark</item>
        <item name="distanceRemainingIconTint">@color/epic_text_primary_dark</item>
        <item name="estimatedArrivalTimeIconTint">@color/epic_text_primary_dark</item>
        <item name="android:textColor">@color/epic_text_primary_dark</item>
        <item name="android:tint">@color/epic_text_primary_dark</item>
    </style>

    <!--
        Info-panel "Arrived" headline. Without `arrivalTextAppearance` the SDK falls back to
        its own default (a mid-grey), which is unreadable on the dark green info panel.
    -->
    <style name="EpicArrivalTextLight" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/epic_text_primary_light</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EpicArrivalTextDark" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Destination / POI name shown in the info panel above the trip progress row. -->
    <style name="EpicPoiNameTextLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_light</item>
    </style>

    <style name="EpicPoiNameTextDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <!-- The floating road-name pill ("Karsaz Service Road"). -->
    <style name="EpicRoadNameTextLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_light</item>
    </style>

    <style name="EpicRoadNameTextDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicManeuverTextAppearanceLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_maneuver_bg_dark</item>
    </style>

    <style name="EpicManeuverTextAppearanceDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicManeuverStyleLight" parent="MapboxStyleManeuverView">
        <item name="maneuverViewBackgroundColor">@color/epic_maneuver_bg_light</item>
        <item name="maneuverViewIconStyle">@style/EpicManeuverIconStyleLight</item>
    </style>

    <style name="EpicManeuverStyleDark" parent="MapboxStyleManeuverView">
        <item name="maneuverViewBackgroundColor">@color/epic_maneuver_bg_dark</item>
        <item name="maneuverViewIconStyle">@style/EpicManeuverIconStyleDark</item>
    </style>


    <!-- <style name="EpicManeuverIconStyleLight" parent="MapboxStyleTurnIconManeuver">
        <item name="android:tint">@color/epic_text_primary_light</item>
        <item name="iconTint">@color/epic_text_primary_light</item>
    </style>

    <style name="EpicManeuverIconStyleDark" parent="MapboxStyleTurnIconManeuver">
        <item name="android:tint">@color/epic_text_primary_dark</item>
        <item name="iconTint">@color/epic_text_primary_dark</item>
    </style> -->
    <style name="EpicManeuverIconStyleLight" parent="MapboxStyleTurnIconManeuver">
        <item name="maneuverTurnIconColor">@color/epic_maneuver_icon_light</item>
        <item name="maneuverTurnIconShadowColor">@android:color/transparent</item>
    </style>

<style name="EpicManeuverIconStyleDark" parent="MapboxStyleTurnIconManeuver">
    <item name="maneuverTurnIconColor">@color/epic_text_primary_dark</item>
    <item name="maneuverTurnIconShadowColor">@android:color/transparent</item>
</style>

    <!-- Camera Mode Button (compass/recenter) -->
    <style name="EpicCameraButtonStyleDark" parent="DropInStyleCameraModeButton">
        <item name="backgroundTint">@color/epic_surface_dark</item>
        <item name="android:backgroundTint">@color/epic_surface_dark</item>
        <item name="cardBackgroundColor">@color/epic_surface_dark</item>
        <item name="iconTint">@color/epic_text_primary_dark</item>
        <item name="android:iconTint">@color/epic_text_primary_dark</item>
        <item name="android:tint">@color/epic_text_primary_dark</item>
        <item name="tint">@color/epic_text_primary_dark</item>
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicCameraButtonStyleLight" parent="DropInStyleCameraModeButton">
        <item name="backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="android:backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="cardBackgroundColor">@color/epic_maneuver_bg_light</item>
        <item name="iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:tint">@color/epic_maneuver_bg_dark</item>
        <item name="tint">@color/epic_maneuver_bg_dark</item>
        <item name="android:textColor">@color/epic_maneuver_bg_dark</item>
    </style>

    <!-- Audio Guidance Button (mute/unmute) -->
    <style name="EpicAudioButtonStyleDark" parent="DropInStyleAudioGuidanceButton">
        <item name="backgroundTint">@color/epic_surface_dark</item>
        <item name="android:backgroundTint">@color/epic_surface_dark</item>
        <item name="cardBackgroundColor">@color/epic_surface_dark</item>
        <item name="iconTint">@color/epic_text_primary_dark</item>
        <item name="android:iconTint">@color/epic_text_primary_dark</item>
        <item name="android:tint">@color/epic_text_primary_dark</item>
        <item name="tint">@color/epic_text_primary_dark</item>
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicAudioButtonStyleLight" parent="DropInStyleAudioGuidanceButton">
        <item name="backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="android:backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="cardBackgroundColor">@color/epic_maneuver_bg_light</item>
        <item name="iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:tint">@color/epic_maneuver_bg_dark</item>
        <item name="tint">@color/epic_maneuver_bg_dark</item>
        <item name="android:textColor">@color/epic_maneuver_bg_dark</item>
    </style>

    <!-- Recenter Button (location target/crosshair) -->
    <style name="EpicRecenterButtonStyleDark" parent="DropInStyleRecenterButton">
        <item name="backgroundTint">@color/epic_surface_dark</item>
        <item name="android:backgroundTint">@color/epic_surface_dark</item>
        <item name="cardBackgroundColor">@color/epic_surface_dark</item>
        <item name="iconTint">@color/epic_text_primary_dark</item>
        <item name="android:iconTint">@color/epic_text_primary_dark</item>
        <item name="android:tint">@color/epic_text_primary_dark</item>
        <item name="tint">@color/epic_text_primary_dark</item>
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>

    <style name="EpicRecenterButtonStyleLight" parent="DropInStyleRecenterButton">
        <item name="backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="android:backgroundTint">@color/epic_maneuver_bg_light</item>
        <item name="cardBackgroundColor">@color/epic_maneuver_bg_light</item>
        <item name="iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:iconTint">@color/epic_maneuver_bg_dark</item>
        <item name="android:tint">@color/epic_maneuver_bg_dark</item>
        <item name="tint">@color/epic_maneuver_bg_dark</item>
        <item name="android:textColor">@color/epic_maneuver_bg_dark</item>
    </style>
</resources>