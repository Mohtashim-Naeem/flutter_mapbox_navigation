<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="EpicTripProgressSubTextLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_accent_secondary_light</item>
    </style>

    <style name="EpicTripProgressSubTextDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_accent</item>
    </style>

    <style name="EpicTripProgressStyleLight" parent="MapboxStyleTripProgressView">
        <item name="tripProgressViewBackgroundColor">@color/epic_surface_light</item>
        <item name="tripProgressTextColor">@color/epic_maneuver_icon_light</item>
        <item name="distanceRemainingTextAppearance">@style/EpicTripProgressSubTextLight</item>
        <item name="estimatedArrivalTimeTextAppearance">@style/EpicTripProgressSubTextLight</item>
        <item name="distanceRemainingIconTint">@color/epic_accent_secondary_light</item>
        <item name="estimatedArrivalTimeIconTint">@color/epic_accent_secondary_light</item>
    </style>

    <style name="EpicTripProgressStyleDark" parent="MapboxStyleTripProgressView">
        <item name="tripProgressViewBackgroundColor">@color/epic_surface_dark</item>
        <item name="tripProgressTextColor">@color/epic_accent</item>
        <item name="distanceRemainingTextAppearance">@style/EpicTripProgressSubTextDark</item>
        <item name="estimatedArrivalTimeTextAppearance">@style/EpicTripProgressSubTextDark</item>
        <item name="distanceRemainingIconTint">@color/epic_accent</item>
        <item name="estimatedArrivalTimeIconTint">@color/epic_accent</item>
    </style>

    <style name="EpicManeuverTextAppearanceLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_light</item>
    </style>

    <style name="EpicManeuverTextAppearanceDark" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/epic_text_primary_dark</item>
    </style>


    <style name="EpicManeuverStyleLight" parent="MapboxStyleManeuverView">
        <item name="maneuverViewBackgroundColor">@color/epic_maneuver_bg_light</item>
        <item name="maneuverViewIconStyle">@style/EpicManeuverIconStyleLight</item>
    </style>

    <style name="EpicManeuverStyleDark" parent="MapboxStyleManeuverView">
        <item name="maneuverViewBackgroundColor">@color/epic_maneuver_bg_dark</item>
        <item name="maneuverViewIconStyle">@style/EpicManeuverIconStyleDark</item>
    </style>


    <!-- <style name="EpicManeuverIconStyleLight" parent="MapboxStyleTurnIconManeuver">
        <item name="android:tint">@color/epic_text_primary_light</item>
        <item name="iconTint">@color/epic_text_primary_light</item>
    </style>

    <style name="EpicManeuverIconStyleDark" parent="MapboxStyleTurnIconManeuver">
        <item name="android:tint">@color/epic_text_primary_dark</item>
        <item name="iconTint">@color/epic_text_primary_dark</item>
    </style> -->
    <style name="EpicManeuverIconStyleLight" parent="MapboxStyleTurnIconManeuver">
        <item name="maneuverTurnIconColor">@color/epic_maneuver_icon_light</item>
        <item name="maneuverTurnIconShadowColor">@android:color/transparent</item>
    </style>

<style name="EpicManeuverIconStyleDark" parent="MapboxStyleTurnIconManeuver">
    <item name="maneuverTurnIconColor">@color/epic_text_primary_dark</item>
    <item name="maneuverTurnIconShadowColor">@android:color/transparent</item>
</style>
</resources>